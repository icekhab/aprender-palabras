{
  "name": "aprender-palabras",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aprender-palabras/web --filter @aprender-palabras/api dev",
    "start": "docker compose up --build",
    "start:prod": "docker compose --env-file .env.prod -f compose.prod.yaml up -d --build",
    "stop": "docker compose down",
    "stop:prod": "docker compose --env-file .env.prod -f compose.prod.yaml down",
    "db:migrate": "pnpm --filter @aprender-palabras/api db:migrate",
    "db:studio": "pnpm --filter @aprender-palabras/api db:studio",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "1.88.0",
    "prettier": "3.9.10"
  }
}
