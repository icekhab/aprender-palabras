generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  teacher
  admin
}

model User {
  id                     String             @id @default(uuid()) @db.Uuid
  login                  String
  normalizedLogin        String             @unique
  passwordHash           String
  role                   UserRole           @default(user)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  currentLessonId        String?            @db.Uuid
  lastCompletedTrainerAt DateTime?          @db.Timestamptz(3)
  sessions               Session[]
  cards                  UserCard[]
  createdWords           Word[]             @relation("WordCreator")
  lessons                Lesson[]           @relation("UserLessons")
  currentLesson          Lesson?            @relation("CurrentLesson", fields: [currentLessonId], references: [id], onDelete: SetNull)
  trainingDays           DailyTrainingDay[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum WordGender {
  masculine
  feminine
}

enum ImageProvider {
  unsplash
}

enum UserCardSource {
  manual
  lesson
}

model Word {
  id                     String         @id @default(uuid()) @db.Uuid
  spanish                String
  russian                String
  normalizedSpanish      String
  normalizedRussian      String
  additionalTranslations String[]       @default([])
  definitionEs           String?
  examples               String[]       @default([])
  partOfSpeech           String?
  gender                 WordGender?
  wrongRussian           String[]       @default([])
  wrongSpanish           String[]       @default([])
  imageUrl               String?
  imagePhotographerName  String?
  imagePhotographerUrl   String?
  imagePageUrl           String?
  imageProvider          ImageProvider?
  createdByUserId        String?        @db.Uuid
  createdViaLesson       Boolean        @default(false)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)
  createdBy              User?          @relation("WordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cards                  UserCard[]
  lessonWords            LessonWord[]
  audio                  WordAudio?

  @@unique([normalizedSpanish, normalizedRussian])
  @@index([createdByUserId])
  @@index([createdAt])
}

model WordAudio {
  wordId    String   @id @db.Uuid
  mp3       Bytes
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model UserCard {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @db.Uuid
  wordId                String              @db.Uuid
  source                UserCardSource
  inDictionary          Boolean             @default(true)
  progress              Int                 @default(0)
  lastTrainedAt         DateTime?           @db.Timestamptz(3)
  completedTrainerCount Int                 @default(0)
  showCount             Int                 @default(0)
  addedAt               DateTime            @default(now()) @db.Timestamptz(3)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  word                  Word                @relation(fields: [wordId], references: [id], onDelete: Restrict)
  trainerWords          DailyTrainerWord[]

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
}

enum DailyTrainerKind {
  daily
  extra
}

enum DailyTrainerStatus {
  not_started
  completed
}

model DailyTrainingDay {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  date      DateTime       @db.Date
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainers  DailyTrainer[]

  @@unique([userId, date])
  @@index([userId])
}

model DailyTrainer {
  id          String             @id @default(uuid()) @db.Uuid
  dayId       String             @db.Uuid
  kind        DailyTrainerKind
  slot        Int
  status      DailyTrainerStatus @default(not_started)
  sourceLabel String
  startedAt   DateTime?          @db.Timestamptz(3)
  completedAt DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  day         DailyTrainingDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  words       DailyTrainerWord[]

  @@unique([dayId, kind, slot])
  @@index([dayId])
}

model DailyTrainerWord {
  id         String       @id @default(uuid()) @db.Uuid
  trainerId  String       @db.Uuid
  userCardId String       @db.Uuid
  position   Int
  trainer    DailyTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  userCard   UserCard     @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@unique([trainerId, position])
  @@unique([trainerId, userCardId])
  @@index([userCardId])
}

model Lesson {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  title      String
  position   Int
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  user       User         @relation("UserLessons", fields: [userId], references: [id], onDelete: Cascade)
  currentFor User[]       @relation("CurrentLesson")
  words      LessonWord[]

  @@unique([userId, position])
  @@index([userId])
}

model LessonWord {
  id       String   @id @default(uuid()) @db.Uuid
  lessonId String   @db.Uuid
  wordId   String   @db.Uuid
  position Int
  addedAt  DateTime @default(now()) @db.Timestamptz(3)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Restrict)

  @@unique([lessonId, wordId])
  @@unique([lessonId, position])
  @@index([wordId])
}
