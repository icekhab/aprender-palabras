generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  login            String
  normalizedLogin  String     @unique
  passwordHash     String
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  currentLessonId  String?    @db.Uuid
  sessions         Session[]
  cards            UserCard[]
  lessons          Lesson[]   @relation("UserLessons")
  currentLesson    Lesson?    @relation("CurrentLesson", fields: [currentLessonId], references: [id], onDelete: SetNull)
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum WordGender {
  masculine
  feminine
}

enum ImageProvider {
  unsplash
}

enum UserCardSource {
  manual
  lesson
}

model Word {
  id                     String         @id @default(uuid()) @db.Uuid
  spanish                String
  russian                String
  normalizedSpanish      String
  normalizedRussian      String
  additionalTranslations String[]       @default([])
  definitionEs           String?
  examples               String[]       @default([])
  partOfSpeech           String?
  gender                 WordGender?
  wrongRussian           String[]       @default([])
  wrongSpanish           String[]       @default([])
  imageUrl               String?
  imagePhotographerName  String?
  imagePhotographerUrl   String?
  imagePageUrl           String?
  imageProvider          ImageProvider?
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)
  cards                  UserCard[]
  lessonWords            LessonWord[]

  @@unique([normalizedSpanish, normalizedRussian])
}

model UserCard {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  wordId       String         @db.Uuid
  source       UserCardSource
  inDictionary Boolean        @default(true)
  progress     Int            @default(0)
  addedAt      DateTime       @default(now()) @db.Timestamptz(3)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word         Word           @relation(fields: [wordId], references: [id], onDelete: Restrict)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
}

model Lesson {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  title      String
  position   Int
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  user       User         @relation("UserLessons", fields: [userId], references: [id], onDelete: Cascade)
  currentFor User[]       @relation("CurrentLesson")
  words      LessonWord[]

  @@unique([userId, position])
  @@index([userId])
}

model LessonWord {
  id       String   @id @default(uuid()) @db.Uuid
  lessonId String   @db.Uuid
  wordId   String   @db.Uuid
  position Int
  addedAt  DateTime @default(now()) @db.Timestamptz(3)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Restrict)

  @@unique([lessonId, wordId])
  @@unique([lessonId, position])
  @@index([wordId])
}
