POSTGRES_DB=aprender_palabras
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Адрес используется backend-контейнером. Имя postgres доступно внутри Compose.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aprender_palabras
# Локально: http://localhost:5173. В production: HTTPS URL фронта на Vercel.
APP_ORIGIN=http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
UNSPLASH_ACCESS_KEY=

# ElevenLabs TTS (cached per word on create / first use)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=qUPtETgSYRhCRb2pfOla
# Optional override; default is eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Production: Vercel + Railway. См. раздел Production в README.
# NODE_ENV=production
